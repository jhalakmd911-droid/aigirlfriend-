# AI Girlfriend - Environment Configuration

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# OpenAI API (for AI conversations)
NEXT_PUBLIC_OPENAI_API_KEY=sk-your_openai_api_key

# Hugging Face API (Alternative to OpenAI)
NEXT_PUBLIC_HUGGINGFACE_API_KEY=hf_your_huggingface_key

# Speech Recognition (Google Cloud)
NEXT_PUBLIC_GOOGLE_CLOUD_API_KEY=your_google_cloud_key

# Text-to-Speech API
NEXT_PUBLIC_ELEVEN_LABS_API_KEY=your_eleven_labs_key

# Environment
NEXT_PUBLIC_APP_ENV=development
