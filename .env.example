# ==========================================
# AI Girlfriend - Environment Configuration
# ==========================================

# Groq AI
# IMPORTANT:
# Never use NEXT_PUBLIC_ for this secret key.

GROQ_API_KEY=your_groq_api_key

# Current Groq production model (✅ সঠিক মডেল)
GROQ_MODEL=llama-3.3-70b-versatile


# ==========================================
# Firebase - Future Authentication/Database
# ==========================================

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id


# ==========================================
# Optional Future Integrations
# ==========================================

NEXT_PUBLIC_HUGGINGFACE_API_KEY=your_huggingface_key
NEXT_PUBLIC_GOOGLE_CLOUD_API_KEY=your_google_cloud_key
NEXT_PUBLIC_ELEVEN_LABS_API_KEY=your_eleven_labs_key


# ==========================================
# Environment
# ==========================================

NEXT_PUBLIC_APP_ENV=development
